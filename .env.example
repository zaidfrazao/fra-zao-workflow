# Copy to .env and fill in. The setup script auto-sources this file.
# .env is gitignored — never commit real keys.

# Lakar project management (required for /fra:lakar and all /zao:* task commands)
# Get one from your Lakar account.
LAKAR_API_KEY=lak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PAL multi-model planner/debug — used by /zao:begin-task (planner) and /zao:fix-issue (debug)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Tavily web search — used by /zao:begin-task, /zao:adjust-feature, /zao:fix-issue
# https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Context7 docs lookup — OPTIONAL (works without a key at lower rate limits)
# https://context7.com/dashboard
# CONTEXT7_API_KEY=

# Note&Task project management — used by /fra and /zao when a project sets
# project_management.provider: notetask in .claude/project.yaml
# Get one from your Note&Task account (MCP create_api_key returns it once).
NOTETASK_API_KEY=nt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# Where to clone/build the Lakar MCP server (default: $HOME/lakar-pm)
# LAKAR_PM_DIR=
# Which Claude Code scope to register servers in (default: user)
# MCP_SCOPE=user
